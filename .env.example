# Airtable Web API (server-side only)
# Local npm job commands optionally load ignored `.env` and then `.env.local`
# files without shell-sourcing them. Existing process variables remain authoritative.
# Create a PAT scoped to this one competitor-tracker base with:
# data.records:read, data.records:write, schema.bases:read, and schema.bases:write.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Airtable serving-layer table names from the agreed design.
AIRTABLE_COMPANIES_TABLE="Companies"
AIRTABLE_KEYWORDS_TABLE="Keywords"
AIRTABLE_PAID_ADS_TABLE="Paid Ads"
AIRTABLE_GTM_INSIGHTS_TABLE="GTM Insights"
AIRTABLE_INSIGHT_REVIEWS_TABLE="Insight Reviews"
AIRTABLE_SYSTEM_TABLE="System"

# Refresh-only provider credentials. These are never needed by web serving or insight commands.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Refresh-only web target. Fixture refreshes do not read or call this setting.
APP_BASE_URL=

# Shared server-only signing secret. Web verifies cache invalidation requests and
# refresh signs them; configure the same value on both Railway services.
CACHE_INVALIDATION_SECRET=
